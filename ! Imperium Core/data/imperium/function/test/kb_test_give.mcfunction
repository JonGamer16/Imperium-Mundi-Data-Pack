# /function imperium:test/kb_test_give -> three Knockback Control test weapons (temporary).
give @s iron_sword[custom_name={text:"Test Rapier",italic:false},custom_data={imperium_kb:{horizontal:30,vertical:0}},enchantments={"imperium:knockback_control":1},lore=[{text:"Knockback: 30%",color:"gray",italic:false}]]
give @s iron_hoe[custom_name={text:"Test Scythe",italic:false},custom_data={imperium_kb:{horizontal:-50,vertical:0}},enchantments={"imperium:knockback_control":1},lore=[{text:"Pulls targets in (50%)",color:"gray",italic:false}]]
give @s iron_shovel[custom_name={text:"Test War Spade",italic:false},custom_data={imperium_kb:{horizontal:100,vertical:50}},enchantments={"imperium:knockback_control":1},lore=[{text:"Launches upward (+50%)",color:"gray",italic:false}]]
